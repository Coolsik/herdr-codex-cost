#!/usr/bin/env bash
set -euo pipefail

# Consume Codex's hook payload even though the pane/session mapping comes from
# Herdr. This prevents a closed pipe from affecting the Codex hook dispatcher.
cat >/dev/null 2>&1 || true

[ "${HERDR_ENV:-}" = "1" ] || exit 0
[ -n "${HERDR_PANE_ID:-}" ] || exit 0

plugin_root="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
state_dir="${HERDR_PLUGIN_STATE_DIR:-${TMPDIR:-/tmp}/herdr-codex-cost-${UID:-user}}"
mkdir -p "$state_dir"

pane_key="$(printf '%s' "$HERDR_PANE_ID" | cksum | awk '{print $1}')"
stamp="$state_dir/hook-$pane_key.stamp"
lock="$state_dir/hook-$pane_key.lock"

mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock" 2>/dev/null || true' EXIT HUP INT TERM

now="$(date +%s)"
last=0
if [ -r "$stamp" ]; then
  IFS= read -r last < "$stamp" || last=0
fi
case "$last" in
  ''|*[!0-9]*) last=0 ;;
esac

if [ "$((now - last))" -lt 5 ]; then
  exit 0
fi
printf '%s\n' "$now" > "$stamp"

"$plugin_root/bin/update-cost" --pane "$HERDR_PANE_ID" >/dev/null 2>&1 || true
