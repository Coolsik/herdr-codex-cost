#!/usr/bin/env bash
set -euo pipefail

herdr_bin="${HERDR_BIN_PATH:-herdr}"
plugin_root="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
mode="${1:-}"

pane_ids() {
  case "$mode" in
    --all)
      "$herdr_bin" pane list | jq -r '.result.panes[]? | select((.agent // "") == "codex") | .pane_id'
      ;;
    --event)
      jq -r '.data.pane_id // empty' <<< "${HERDR_PLUGIN_EVENT_JSON:-{}}"
      ;;
    --pane)
      printf '%s\n' "${2:-}"
      ;;
    *)
      jq -r '.focused_pane_id // .pane_id // empty' <<< "${HERDR_PLUGIN_CONTEXT_JSON:-{}}"
      ;;
  esac
}

update_pane() {
  local pane_id="$1" pane_json agent session_id cost
  [ -n "$pane_id" ] || return 0
  pane_json="$("$herdr_bin" pane get "$pane_id" 2>/dev/null || true)"
  agent="$(jq -r '.result.pane.agent // empty' <<< "$pane_json")"
  if [ "$agent" != "codex" ]; then
    "$herdr_bin" pane report-metadata "$pane_id" --source herdr-codex-cost --clear-token cost >/dev/null 2>&1 || true
    return 0
  fi
  session_id="$(jq -r '.result.pane.agent_session | select(.agent == "codex") | select(.kind == "id") | .value // empty' <<< "$pane_json")"
  if [ -z "$session_id" ]; then
    "$herdr_bin" pane report-metadata "$pane_id" --source herdr-codex-cost --token 'cost=…' >/dev/null
    return 0
  fi
  cost="$("$plugin_root/bin/codex-cost" --session "$session_id")"
  [ -n "$cost" ] || cost='…'
  "$herdr_bin" pane report-metadata "$pane_id" --source herdr-codex-cost --token "cost=$cost" >/dev/null
}

command -v jq >/dev/null 2>&1 || { printf 'jq is required\n' >&2; exit 1; }
while IFS= read -r pane_id; do
  update_pane "$pane_id"
done < <(pane_ids)
