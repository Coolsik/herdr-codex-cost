#!/usr/bin/env bash
set -euo pipefail

herdr_bin="${HERDR_BIN_PATH:-herdr}"
plugin_root="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
state_dir="${HERDR_PLUGIN_STATE_DIR:-${TMPDIR:-/tmp}/herdr-codex-cost-${UID:-user}}"
mode="${1:-}"
target_pane="${2:-}"

json_env() {
  local value="${!1:-}"
  [ -n "$value" ] && printf '%s\n' "$value" || printf '{}\n'
}

pane_ids() {
  case "$mode" in
    --all)
      "$herdr_bin" pane list | jq -r '.result.panes[]? | select((.agent // "") == "codex") | .pane_id'
      ;;
    --event)
      json_env HERDR_PLUGIN_EVENT_JSON | jq -r '.data.pane_id // empty'
      ;;
    --pane)
      printf '%s\n' "$target_pane"
      ;;
    --poll)
      printf '%s\n' "$target_pane"
      ;;
    *)
      json_env HERDR_PLUGIN_CONTEXT_JSON | jq -r '.focused_pane_id // .pane_id // empty'
      ;;
  esac
}

pane_key() {
  printf '%s' "$1" | cksum | awk '{print $1}'
}

diagnostic_file() {
  printf '%s/error-%s.log\n' "$state_dir" "$(pane_key "$1")"
}

record_diagnostic() {
  local pane_id="$1" code="$2" message="$3" file temporary content
  mkdir -p "$state_dir"
  file="$(diagnostic_file "$pane_id")"
  content="$(printf 'pane_id=%s\ncode=%s\nmessage=%s\n' "$pane_id" "$code" "$message")"
  if [ -r "$file" ] && [ "$(cat "$file")" = "$content" ]; then
    return 0
  fi
  temporary="$file.$$.tmp"
  printf '%s\n' "$content" > "$temporary"
  mv "$temporary" "$file"
}

clear_diagnostic() {
  local file
  file="$(diagnostic_file "$1")"
  [ ! -e "$file" ] || rm -f "$file"
}

update_pane() {
  local pane_id="$1" pane_json agent session_id pane_key cache_file cost existing_cost
  local -a cost_args
  [ -n "$pane_id" ] || return 0
  pane_json="$("$herdr_bin" pane get "$pane_id" 2>/dev/null || true)"
  agent="$(jq -r '.result.pane.agent // empty' <<< "$pane_json")"
  existing_cost="$(jq -r '.result.pane.tokens.cost // empty' <<< "$pane_json")"
  if [ "$agent" != "codex" ]; then
    clear_diagnostic "$pane_id"
    return 0
  fi
  session_id="$(jq -r '.result.pane.agent_session | select(.agent == "codex") | select(.kind == "id") | .value // empty' <<< "$pane_json")"
  if [ -z "$session_id" ] && [ -x "$plugin_root/bin/resolve-pane-session" ]; then
    session_id="$("$plugin_root/bin/resolve-pane-session" --pane "$pane_id" 2>/dev/null || true)"
  fi
  if [ -z "$session_id" ]; then
    record_diagnostic "$pane_id" "missing_agent_session" \
      "Herdr did not associate this Codex pane with a thread ID and no unique status-line or title fallback matched."
    if [ -z "$existing_cost" ] || [ "$existing_cost" = '…' ]; then
      "$herdr_bin" pane report-metadata "$pane_id" --source herdr-codex-cost --token 'cost=session?' >/dev/null
    fi
    return 0
  fi
  clear_diagnostic "$pane_id"
  mkdir -p "$state_dir"
  pane_key="$(pane_key "$pane_id")"
  cache_file="$state_dir/cost-$pane_key.json"
  cost_args=("$plugin_root/bin/codex-cost" --session "$session_id" --cache-file "$cache_file")
  [ "$mode" = "--poll" ] && cost_args+=(--changed-only)
  cost="$("${cost_args[@]}")"
  if [ "$mode" = "--poll" ] && [ -z "$cost" ]; then
    return 0
  fi
  [ -n "$cost" ] || cost='…'
  if [ "$cost" = '…' ] && [ -n "$existing_cost" ] && [ "$existing_cost" != '…' ]; then
    return 0
  fi
  "$herdr_bin" pane report-metadata "$pane_id" --source herdr-codex-cost --token "cost=$cost" >/dev/null
}

command -v jq >/dev/null 2>&1 || { printf 'jq is required\n' >&2; exit 1; }
while IFS= read -r pane_id; do
  update_pane "$pane_id"
done < <(pane_ids)
