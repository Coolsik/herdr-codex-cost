#!/usr/bin/env bash
set -euo pipefail

herdr_bin="${HERDR_BIN_PATH:-herdr}"
script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/poll-cost"
plugin_root="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$script_path")/.." && pwd)}"
state_dir="${HERDR_PLUGIN_STATE_DIR:-${TMPDIR:-/tmp}/herdr-codex-cost-${UID:-user}}"
interval="${HERDR_CODEX_COST_POLL_SECONDS:-5}"
mode="${1:-}"

pane_key() {
  printf '%s' "$1" | cksum | awk '{print $1}'
}

pane_info() {
  "$herdr_bin" pane get "$1" 2>/dev/null || true
}

worker() {
  local pane_id="$1" key owner pane_json agent status
  key="$(pane_key "$pane_id")"
  worker_lock="$state_dir/poll-$key.lock"
  worker_pid_file="$worker_lock/pid"
  mkdir -p "$state_dir"

  if ! mkdir "$worker_lock" 2>/dev/null; then
    owner=""
    [ -r "$worker_pid_file" ] && IFS= read -r owner < "$worker_pid_file" || true
    case "$owner" in
      ''|*[!0-9]*) ;;
      *) kill -0 "$owner" 2>/dev/null && return 0 ;;
    esac
    rm -f "$worker_pid_file"
    rmdir "$worker_lock" 2>/dev/null || return 0
    mkdir "$worker_lock" 2>/dev/null || return 0
  fi

  printf '%s\n' "$$" > "$worker_pid_file"
  cleanup() {
    local current=""
    [ -r "$worker_pid_file" ] && IFS= read -r current < "$worker_pid_file" || true
    if [ "$current" = "$$" ]; then
      rm -f "$worker_pid_file"
      rmdir "$worker_lock" 2>/dev/null || true
    fi
  }
  trap cleanup EXIT
  trap 'exit 0' HUP INT TERM

  while true; do
    pane_json="$(pane_info "$pane_id")"
    agent="$(jq -r '.result.pane.agent // empty' <<< "$pane_json")"
    status="$(jq -r '.result.pane.agent_status // empty' <<< "$pane_json")"
    [ "$agent" = "codex" ] && [ "$status" = "working" ] || break
    "$plugin_root/bin/update-cost" --poll "$pane_id" >/dev/null 2>&1 || true
    [ "${HERDR_CODEX_COST_POLL_ONCE:-0}" = "1" ] && break
    sleep "$interval"
  done
}

start_worker() {
  if [ "${HERDR_CODEX_COST_POLL_FOREGROUND:-0}" = "1" ]; then
    bash "$script_path" --worker "$1"
  else
    nohup bash "$script_path" --worker "$1" </dev/null >/dev/null 2>&1 &
  fi
}

event_pane_id() {
  local event_json="${HERDR_PLUGIN_EVENT_JSON:-}"
  [ -n "$event_json" ] && printf '%s\n' "$event_json" || printf '{}\n'
}

command -v jq >/dev/null 2>&1 || { printf 'jq is required\n' >&2; exit 1; }

case "$mode" in
  --worker)
    worker "${2:-}"
    ;;
  --event)
    pane_id="$(event_pane_id | jq -r '.data.pane_id // empty')"
    [ -n "$pane_id" ] || exit 0
    pane_json="$(pane_info "$pane_id")"
    agent="$(jq -r '.result.pane.agent // empty' <<< "$pane_json")"
    status="$(jq -r '.result.pane.agent_status // empty' <<< "$pane_json")"
    if [ "$agent" = "codex" ] && [ "$status" = "working" ]; then
      start_worker "$pane_id"
    else
      "$plugin_root/bin/update-cost" --pane "$pane_id" >/dev/null 2>&1 || true
    fi
    ;;
  --startup)
    "$plugin_root/bin/update-cost" --all >/dev/null 2>&1 || true
    while IFS= read -r pane_id; do
      start_worker "$pane_id"
    done < <(
      "$herdr_bin" pane list 2>/dev/null |
        jq -r '.result.panes[]? | select((.agent // "") == "codex" and (.agent_status // "") == "working") | .pane_id'
    )
    ;;
  *)
    printf 'Usage: poll-cost --startup|--event|--worker PANE_ID\n' >&2
    exit 2
    ;;
esac
