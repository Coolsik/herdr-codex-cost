#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT

mkdir -p "$fixture/plugin/bin" "$fixture/state"

cat > "$fixture/herdr" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "$HERDR_CAPTURE"
case "$1 $2" in
  "pane get")
    case "$3" in
      w1:p9) printf '%s\n' '{"result":{"pane":{"pane_id":"w1:p9","agent_status":"unknown","tokens":{"cost":"~$9.99"}}}}' ;;
      w1:p10) printf '%s\n' '{"result":{"pane":{"pane_id":"w1:p10","agent":"codex","tokens":{"cost":"~$9.99"}}}}' ;;
      w1:p11) printf '%s\n' '{"result":{"pane":{"pane_id":"w1:p11","agent":"codex"}}}' ;;
      w1:p12) printf '%s\n' '{"result":{"pane":{"pane_id":"w1:p12","agent":"codex","agent_session":{"agent":"codex","kind":"id","value":"session-empty"},"tokens":{"cost":"~$9.99"}}}}' ;;
      *) printf '{"result":{"pane":{"pane_id":"%s","agent":"codex","agent_session":{"agent":"codex","kind":"id","value":"session-1"}}}}\n' "$3" ;;
    esac
    ;;
  "pane report-metadata") ;;
  *) exit 1 ;;
esac
SH
chmod +x "$fixture/herdr"

cat > "$fixture/plugin/bin/codex-cost" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "$COST_CAPTURE"
case " $* " in
  *" --session session-empty "*) printf '%s\n' '…' ;;
  *) printf '%s\n' '~$1.23' ;;
esac
SH
chmod +x "$fixture/plugin/bin/codex-cost"

run_update() {
  HERDR_CAPTURE="$fixture/herdr-calls" \
    COST_CAPTURE="$fixture/cost-calls" \
    HERDR_BIN_PATH="$fixture/herdr" \
    HERDR_PLUGIN_ROOT="$fixture/plugin" \
    HERDR_PLUGIN_STATE_DIR="$fixture/state" \
    "$root/bin/update-cost" "$@"
}

run_update --pane w1:p7
grep -Fx -- 'pane get w1:p7' "$fixture/herdr-calls" >/dev/null
grep -Fx -- 'pane report-metadata w1:p7 --source herdr-codex-cost --token cost=~$1.23' "$fixture/herdr-calls" >/dev/null
grep -E -- '^--session session-1 --cache-file .*/cost-[0-9]+\.json$' "$fixture/cost-calls" >/dev/null

: > "$fixture/herdr-calls"
: > "$fixture/cost-calls"
run_update --poll w1:p8
grep -Fx -- 'pane get w1:p8' "$fixture/herdr-calls" >/dev/null
grep -Fx -- 'pane report-metadata w1:p8 --source herdr-codex-cost --token cost=~$1.23' "$fixture/herdr-calls" >/dev/null
grep -E -- '^--session session-1 --cache-file .*/cost-[0-9]+\.json --changed-only$' "$fixture/cost-calls" >/dev/null

for pane_id in w1:p9 w1:p10; do
  : > "$fixture/herdr-calls"
  run_update --pane "$pane_id"
  [ "$(wc -l < "$fixture/herdr-calls")" -eq 1 ] || {
    printf 'existing cost was replaced for transient pane %s\n' "$pane_id" >&2
    exit 1
  }
  grep -Fx -- "pane get $pane_id" "$fixture/herdr-calls" >/dev/null
done

: > "$fixture/herdr-calls"
run_update --pane w1:p11
grep -Fx -- 'pane report-metadata w1:p11 --source herdr-codex-cost --token cost=session?' "$fixture/herdr-calls" >/dev/null
diagnostic="$(find "$fixture/state" -name 'error-*.log' -exec grep -lFx 'pane_id=w1:p11' {} + | head -1)"
[ -n "$diagnostic" ]
grep -Fx -- 'pane_id=w1:p11' "$diagnostic" >/dev/null
grep -Fx -- 'code=missing_agent_session' "$diagnostic" >/dev/null

: > "$fixture/herdr-calls"
run_update --pane w1:p7
if find "$fixture/state" -name 'error-*.log' -exec grep -Flx 'pane_id=w1:p7' {} + | grep -q .; then
  printf 'successful update retained a stale diagnostic\n' >&2
  exit 1
fi

: > "$fixture/herdr-calls"
run_update --pane w1:p12
[ "$(wc -l < "$fixture/herdr-calls")" -eq 1 ] || {
  printf 'existing cost was replaced by an unavailable new-session cost\n' >&2
  exit 1
}
grep -Fx -- 'pane get w1:p12' "$fixture/herdr-calls" >/dev/null

printf 'update cost tests passed\n'
