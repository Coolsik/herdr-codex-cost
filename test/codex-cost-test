import copy
import json
import sys
from pathlib import Path
base = Path(sys.argv[1]) / "sessions/2026/07/23"
def write(name, usages, model="gpt-6.1-sol", last=True):
    events = [{"type": "turn_context", "payload": {"model": model}}]
    for usage in usages:
        info = {"total_token_usage": usage}
        if last:
            info["last_token_usage"] = usage
        events.append({"type": "event_msg", "payload": {"type": "token_count", "info": info}})
    (base / f"rollout-2026-07-23T00-00-00-{name}.jsonl").write_text(
        "".join(json.dumps(event) + "\n" for event in events))
def usage(input=100000, short=30000, long=20000):
    return {"input_tokens": input, "output_tokens": 10000,
            "input_tokens_details": {"cached_tokens": 20000,
                "cache_write_tokens": short + long,
                "cache_write_tokens_details": {"ttl_30m_tokens": short, "ttl_12h_tokens": long}}}
write("terra61-mixed", [usage()], model="gpt-6.1-terra")
write("terra61-12h", [usage(short=0, long=50000)], model="gpt-6.1-terra")
write("terra61-long-mixed", [usage(input=300000)], model="gpt-6.1-terra")
write("terra61-long-12h", [usage(input=300000, short=0, long=50000)], model="gpt-6.1-terra")
write("mixed-writes", [usage()])
write("all-12h", [usage(short=0, long=50000)])
write("all-30m", [usage(short=50000, long=0)])
write("mixed-long", [usage(input=300000)])
write("mixed-boundary", [usage(input=272000)])
write("mixed-above", [usage(input=272001)])
write("mixed-alias", [usage()], model="gpt-daybreak-blue-latest")
write("cyber6-lifetimes", [usage(input=300000)], model="gpt-5.6-cyber")
write("red-lifetimes", [usage(input=300000)], model="gpt-daybreak-red-latest")
write("mixed-old-model", [usage()], model="gpt-5.5")
first = usage()
second = usage(input=200000, short=60000, long=40000)
second["output_tokens"] = 20000
second["input_tokens_details"]["cached_tokens"] = 40000
write("mixed-cumulative", [first, second], last=False)
for name, value in (("negative", -1), ("boolean", True), ("missing", None), ("mismatch", 1)):
    bad = copy.deepcopy(second)
    bad["input_tokens_details"]["cache_write_tokens_details"]["ttl_12h_tokens"] = value
    write("split-" + name, [first, bad])
bad = copy.deepcopy(second)
bad["cache_write_input_tokens"] = 1
write("split-conflict", [first, bad])
# A Codex cumulative counter can stay flat while the request preserves API details.
write("request-split", [first])
path = base / "rollout-2026-07-23T00-00-00-request-split.jsonl"
events = [json.loads(line) for line in path.read_text().splitlines()]
info = events[-1]["payload"]["info"]
info["total_token_usage"] = {"input_tokens": 100000, "cached_input_tokens": 20000,
                             "cache_write_input_tokens": 50000, "output_tokens": 10000}
path.write_text("".join(json.dumps(event) + "\n" for event in events))
info["last_token_usage"] = bad
(base / "rollout-2026-07-23T00-00-00-malformed-request.jsonl").write_text(
    "".join(json.dumps(event) + "\n" for event in events))
