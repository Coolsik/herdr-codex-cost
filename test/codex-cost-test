#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT

make_rollout() {
  local id="$1" model="$2" input="$3" cached="$4" output="$5"
  local path="$fixture/sessions/2026/07/23/rollout-2026-07-23T00-00-00-$id.jsonl"
  mkdir -p "$(dirname "$path")"
  printf '%s\n' \
    "{\"type\":\"turn_context\",\"payload\":{\"model\":\"$model\"}}" \
    "{\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"total_token_usage\":{\"input_tokens\":$input,\"cached_input_tokens\":$cached,\"output_tokens\":$output}}}}" > "$path"
}

make_long_context_rollout() {
  local id="$1" model="$2" input="$3" cached="$4" output="$5"
  local writes="${6:-0}"
  local path="$fixture/sessions/2026/07/23/rollout-2026-07-23T00-00-00-$id.jsonl"
  mkdir -p "$(dirname "$path")"
  printf '%s\n' \
    "{\"type\":\"turn_context\",\"payload\":{\"model\":\"$model\"}}" \
    "{\"type\":\"event_msg\",\"payload\":{\"type\":\"token_count\",\"info\":{\"total_token_usage\":{\"input_tokens\":$input,\"cached_input_tokens\":$cached,\"cache_write_input_tokens\":$writes,\"output_tokens\":$output,\"total_tokens\":$((input + output))},\"last_token_usage\":{\"input_tokens\":$input,\"cached_input_tokens\":$cached,\"cache_write_input_tokens\":$writes,\"output_tokens\":$output,\"total_tokens\":$((input + output))}}}}" > "$path"
}

assert_cost() {
  local id="$1" expected="$2" actual
  actual="$("$root/bin/codex-cost" --codex-home "$fixture" --session "$id")"
  [ "$actual" = "$expected" ] || { printf 'expected %s, got %s\n' "$expected" "$actual" >&2; exit 1; }
}

assert_home_cost() {
  local home="$1" id="$2" expected="$3" actual
  actual="$("$root/bin/codex-cost" --codex-home "$home" --session "$id")"
  [ "$actual" = "$expected" ] || { printf 'expected %s, got %s\n' "$expected" "$actual" >&2; exit 1; }
}

